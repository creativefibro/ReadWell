{
  "manifest_version": 3,
  "name": "Save to ReadWell",
  "version": "0.1.0",
  "description": "Save the article you're reading to your ReadWell Queue, including pages you're signed in to.",
  "action": { "default_title": "Save to ReadWell", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" }, "description": "Save this page to ReadWell" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4320/*", "https://readwell.susanpearson.uk/*"],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
